# Fiber360 FTTH backend — required environment variables
# Copy this file to your Zeabur service variables (or a local shell) with real
# values.  Keep secrets out of git.

# --- Database (PostGIS) ---
# OPTIONAL OVERRIDES: settings.py ships a hardcoded fallback for the shared
# Zeabur Postgres, so the backend works without these. Set them only to
# override.  Local dev (FTTH_DB=local/dev/docker) uses a local PostGIS on
# localhost:5432 with defaults ftth/ftth/ftth.
PGDATABASE=zeabur
PGUSER=root
PGPASSWORD=replace-with-zeabur-db-password
PGHOST=91.98.18.217
PGPORT=32467

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false

# --- FTTH engine (FastAPI) ---
# Local: http://localhost:8080   |   Production: https://ftth-planning.onrender.com
FTTH_ENGINE_URL=https://ftth-planning.onrender.com

# --- Tape OCR fallback (optional) ---
# The tape reader runs tesseract locally for free. When a field photo is too
# glare-blown or too tilted for it, the endpoint falls back to one Google Cloud
# Vision TEXT_DETECTION call per photo. First 1,000 units a month are free, then
# $1.50 per 1,000. Leave empty to disable the fallback entirely.
GOOGLE_VISION_API_KEY=

# --- CORS (dev only) ---
# CORS_ALLOW_ALL_ORIGINS=true
